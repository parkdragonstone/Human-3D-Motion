# # 촬영본과 분석 결과를 둘 호스트 폴더. 기본은 레포 루트의 data/.
# # 예: H3DM_DATA=/Users/yongseok/Desktop/Python/Human-3D-Motion/demo
# #     H3DM_DATA=D:/H3DM-Data
# H3DM_DATA=../data

# # 폰 QR 에 들어갈 주소를 고정한다. 비워 두면 "운영자가 접속한 주소"를 따라가므로
# H3DM_PUBLIC_URL=https://192.168.0.10:9090
# H3DM_PORT=9090

# # 추론 스레드 수. 코어 수에 맞춘다.
# H3DM_THREADS=4

# # 세션 폴더 이름에 쓰이는 시간대.
# TZ=Asia/Seoul
