FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BASEBALL_MOTION_HOST=0.0.0.0 \
    BASEBALL_MOTION_PORT=5000 \
    BASEBALL_MOTION_HTTPS=0

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    nodejs \
    npm \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY environment-gpu.yml package.json package-lock.json ./
RUN python3 -m pip install --break-system-packages --no-cache-dir \
    "flask>=3.0.0" \
    "flask-socketio>=5.3.0" \
    "qrcode[pil]>=7.4.0" \
    "pyopenssl>=23.0.0" \
    "numpy>=1.24.0" \
    "scipy>=1.11.0" \
    "ultralytics>=8.0.0" \
    "rtmlib>=0.0.13" \
    "opencv-python>=4.12.0.0" \
    "onnxruntime-gpu>=1.23.0" \
    "openvino>=2025.0.0" \
    "pandas>=2.2.0" \
    "lxml>=5.0.0" \
    "opensim>=4.6" \
    && npm ci

RUN python3 -m pip uninstall --break-system-packages -y onnxruntime || true \
    && python3 -m pip install --break-system-packages --no-cache-dir --force-reinstall --no-deps "onnxruntime-gpu>=1.23.0"

COPY . .
RUN npm run build:ts

EXPOSE 5000

CMD ["python3", "-m", "webapp.main"]
